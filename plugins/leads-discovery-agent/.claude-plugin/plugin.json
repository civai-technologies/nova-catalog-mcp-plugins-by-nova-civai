{
  "$schema": "https://json.schemastore.org/claude-code-plugin.json",
  "name": "leads-discovery-agent-by-nova",
  "displayName": "Leads Discovery Agent by Nova (CIVAI)",
  "version": "1.0.0",
  "description": "I discover new leads from WhatsApp/Telegram groups, Instagram post commenters, and X thread repliers, then import them into your Support Agent CRM",
  "author": {
    "name": "CIVAI TECHNOLOGIES",
    "email": "nifemialpine@nova.civai.co",
    "url": "https://nova.civai.co"
  },
  "homepage": "https://nova.civai.co/agent/leads-discovery-agent",
  "repository": "https://github.com/civai-technologies/leads-discovery-agent-mcp-by-nova-civai",
  "license": "MIT",
  "keywords": [
    "lead-generation",
    "prospecting",
    "x-scraper",
    "sales-leads"
  ],
  "icon": "./assets/logo.svg",
  "documentationUrl": "https://nova.civai.co/agent/leads-discovery-agent",
  "supportUrl": "https://nova.civai.co/api-keys",
  "privacyPolicyUrl": "https://nova.civai.co/privacy",
  "termsOfServiceUrl": "https://nova.civai.co/terms",
  "userConfig": {
    "nova_api_key": {
      "type": "string",
      "title": "Nova API key",
      "description": "Programmatic Nova API key from https://nova.civai.co/api-keys",
      "required": true,
      "sensitive": true
    }
  },
  "mcpServers": {
    "leads-discovery-agent-by-nova": {
      "type": "http",
      "url": "https://nova.civai.co/mcp/agents/leads-discovery-agent",
      "headers": {
        "Authorization": "Bearer ${user_config.nova_api_key}"
      }
    }
  }
}
