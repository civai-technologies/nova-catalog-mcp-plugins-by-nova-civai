{
  "$schema": "https://json.schemastore.org/claude-code-plugin.json",
  "name": "code-interpreter-agent-by-nova",
  "displayName": "Code Interpreter Agent by Nova (CIVAI)",
  "version": "1.0.0",
  "description": "I do everything related to coding and execution tasks",
  "author": {
    "name": "CIVAI TECHNOLOGIES",
    "email": "nifemialpine@nova.civai.co",
    "url": "https://nova.civai.co"
  },
  "homepage": "https://nova.civai.co/agent/code-interpreter-agent",
  "repository": "https://github.com/civai-technologies/code-interpreter-agent-mcp-by-nova-civai",
  "license": "MIT",
  "keywords": [
    "code-interpreter",
    "python",
    "sandbox"
  ],
  "icon": "./assets/logo.svg",
  "documentationUrl": "https://nova.civai.co/agent/code-interpreter-agent",
  "supportUrl": "https://nova.civai.co/api-keys",
  "privacyPolicyUrl": "https://nova.civai.co/privacy",
  "termsOfServiceUrl": "https://nova.civai.co/terms",
  "userConfig": {
    "nova_api_key": {
      "type": "string",
      "title": "Nova API key",
      "description": "Programmatic Nova API key from https://nova.civai.co/api-keys",
      "required": true,
      "sensitive": true
    }
  },
  "mcpServers": {
    "code-interpreter-agent-by-nova": {
      "type": "http",
      "url": "https://nova.civai.co/mcp/agents/code-interpreter-agent",
      "headers": {
        "Authorization": "Bearer ${user_config.nova_api_key}"
      }
    }
  }
}
