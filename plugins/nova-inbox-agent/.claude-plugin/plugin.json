{
  "$schema": "https://json.schemastore.org/claude-code-plugin.json",
  "name": "nova-inbox-agent-by-nova",
  "displayName": "Nova Inbox Agent by Nova (CIVAI)",
  "version": "1.0.0",
  "description": "Read and send mail from your Nova Inbox (@nova.civai.co) for OTPs, directory signups, and inbound messages",
  "author": {
    "name": "CIVAI TECHNOLOGIES",
    "email": "nifemialpine@nova.civai.co",
    "url": "https://nova.civai.co"
  },
  "homepage": "https://nova.civai.co/agent/nova-inbox-agent",
  "repository": "https://github.com/civai-technologies/email-inbox-agent-mcp-by-nova-civai",
  "license": "MIT",
  "keywords": [
    "email-inbox",
    "nova-inbox",
    "email",
    "otp",
    "directory-signup",
    "inbound-mail"
  ],
  "icon": "./assets/logo.svg",
  "documentationUrl": "https://nova.civai.co/agent/nova-inbox-agent",
  "supportUrl": "https://nova.civai.co/api-keys",
  "privacyPolicyUrl": "https://nova.civai.co/privacy",
  "termsOfServiceUrl": "https://nova.civai.co/terms",
  "userConfig": {
    "nova_api_key": {
      "type": "string",
      "title": "Nova API key",
      "description": "Programmatic Nova API key from https://nova.civai.co/api-keys",
      "required": true,
      "sensitive": true
    }
  },
  "mcpServers": {
    "nova-inbox-agent-by-nova": {
      "type": "http",
      "url": "https://nova.civai.co/mcp/agents/nova-inbox-agent",
      "headers": {
        "Authorization": "Bearer ${user_config.nova_api_key}"
      }
    }
  }
}
