{
  "$schema": "https://json.schemastore.org/claude-code-plugin.json",
  "name": "content-pipeline-agent-by-nova",
  "displayName": "Content Pipeline Agent by Nova (CIVAI)",
  "version": "1.1.0",
  "description": "I run the Content Pipeline for your Nova products, scan trends, expand seeds into opportunities, generate drafts, publish to your configured destination, and submit for indexing",
  "author": {
    "name": "CIVAI TECHNOLOGIES",
    "email": "nifemialpine@nova.civai.co",
    "url": "https://nova.civai.co"
  },
  "homepage": "https://nova.civai.co/agent/content-pipeline-agent",
  "repository": "https://github.com/civai-technologies/content-pipeline-agent-mcp-by-nova-civai",
  "license": "MIT",
  "keywords": [
    "content",
    "pipeline"
  ],
  "icon": "./assets/logo.svg",
  "documentationUrl": "https://nova.civai.co/agent/content-pipeline-agent",
  "supportUrl": "https://nova.civai.co/api-keys",
  "privacyPolicyUrl": "https://nova.civai.co/privacy",
  "termsOfServiceUrl": "https://nova.civai.co/terms",
  "userConfig": {
    "nova_api_key": {
      "type": "string",
      "title": "Nova API key",
      "description": "Programmatic Nova API key from https://nova.civai.co/api-keys",
      "required": true,
      "sensitive": true
    }
  },
  "mcpServers": {
    "content-pipeline-agent-by-nova": {
      "type": "http",
      "url": "https://nova.civai.co/mcp/agents/content-pipeline-agent",
      "headers": {
        "Authorization": "Bearer ${user_config.nova_api_key}"
      }
    }
  }
}
